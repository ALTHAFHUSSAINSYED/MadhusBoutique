# ========================================================
# Madhus Boutique — Environment Variables
# ========================================================
# This is the SINGLE .env template file (tracked in Git).
# It contains placeholder values ONLY — no real secrets.
#
# HOW TO USE:
#   Local dev  → Copy to .env.local and fill in real values
#               (.env.local is gitignored — never committed)
#   Production → Add real values in Vercel Project Settings
#               (Dashboard → Project → Settings → Env Variables)
#
# ⚠️  NEVER paste real API keys, passwords, or tokens here.
# ========================================================

# ----------------------------------------------------------
# Supabase PostgreSQL & Auth (get from supabase.com dashboard)
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[your-project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ CRITICAL: Server-side only. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------
# AWS S3 — 100% Private Bucket (Block Public Access ON)
# ⚠️ Server-side ONLY. Never prefix with NEXT_PUBLIC_
# ----------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=madhus-boutique-private
AWS_ACCESS_KEY_ID=your-iam-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key-here

# ----------------------------------------------------------
# Site URL (your production domain)
# ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://madhusboutique.com

# ----------------------------------------------------------
# Admin Session Security
# ⚠️ Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ----------------------------------------------------------
ADMIN_SESSION_SECRET=your-64-char-cryptographic-random-secret-here

# ----------------------------------------------------------
# Storefront Branding & Public Contact Info
# ----------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Madhu's Boutique"
NEXT_PUBLIC_SUPPORT_PHONE="+918142073385"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+918142073385"
NEXT_PUBLIC_SECONDARY_PHONE="+919390213935"
NEXT_PUBLIC_SUPPORT_EMAIL="Madhusboutiquenrt@gmail.com"

# ----------------------------------------------------------
# Payment Configuration (UPI — V1)
# ----------------------------------------------------------
NEXT_PUBLIC_MERCHANT_UPI_ID=Madhusboutiquenrt@ybl
DEFAULT_MERCHANT_NAME="Bikki Rakshana Devi"
